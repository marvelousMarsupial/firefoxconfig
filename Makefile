# Build a .deb that drops this config into /usr/lib/firefox-esr.
#   make deb        build/firefoxconfig_<version>_all.deb
#   make install    build and dpkg -i (Firefox must be closed)
#   make reload     clear the profile startup cache so changed scripts load
#   make update-fxac  refresh vendor/fx-autoconfig from upstream

VERSION    ?= 0.1.0
MAINTAINER ?= $(shell git config user.name) <$(shell git config user.email)>
FXDIR       = /usr/lib/firefox-esr
BUILD       = build
ROOT        = $(BUILD)/root
DEST        = $(ROOT)$(FXDIR)
DEB         = $(BUILD)/firefoxconfig_$(VERSION)_all.deb
FXAC        = vendor/fx-autoconfig

SCRIPTS = $(wildcard chrome/JS/*.uc.js)

.PHONY: deb install reload update-fxac check clean

deb: $(DEB)

$(DEB): check betterfox.js overrides.js policies.json chrome/userChrome.css $(SCRIPTS) pkg/control pkg/config.js.tail $(wildcard $(FXAC)/utils/*)
	rm -rf $(ROOT)
	mkdir -p $(DEST)/defaults/pref $(DEST)/distribution \
	         $(DEST)/firefoxconfig/chrome/JS $(DEST)/firefoxconfig/chrome/resources \
	         $(ROOT)/usr/share/doc/firefoxconfig $(ROOT)/DEBIAN
	# config.js: first line is skipped by Firefox, then prefs as user prefs, then the loader.
	# Each pref is wrapped in try so one bad line cannot abort the whole file.
	{ echo '// firefoxconfig, generated by make. Do not edit, edit overrides.js.'; \
	  cat betterfox.js overrides.js | sed -E 's/^user_pref\((.*)\);(\s*\/\/.*)?\s*$$/try { pref(\1); } catch (e) {}\2/'; \
	  cat pkg/config.js.tail; } > $(DEST)/config.js
	cp $(FXAC)/config-prefs.js $(DEST)/defaults/pref/config-prefs.js
	cp policies.json $(DEST)/distribution/policies.json
	cp -r $(FXAC)/utils $(DEST)/firefoxconfig/chrome/utils
	cp chrome/userChrome.css $(DEST)/firefoxconfig/chrome/userChrome.css
	cp $(SCRIPTS) $(DEST)/firefoxconfig/chrome/JS/
	cp surfingkeys.js README.md $(ROOT)/usr/share/doc/firefoxconfig/
	cp $(FXAC)/LICENSE $(ROOT)/usr/share/doc/firefoxconfig/LICENSE.fx-autoconfig
	sed -e 's/@VERSION@/$(VERSION)/' -e 's/@MAINTAINER@/$(MAINTAINER)/' pkg/control > $(ROOT)/DEBIAN/control
	find $(ROOT) -type d -exec chmod 755 {} + -o -type f -exec chmod 644 {} +
	dpkg-deb --root-owner-group --build $(ROOT) $(DEB)

check:
	jq empty policies.json
	@test "$$(grep -c '^user_pref(' betterfox.js overrides.js | awk -F: '{s+=$$2} END{print s}')" = \
	      "$$(grep -cE '^user_pref\(.*\);\s*(//.*)?$$' betterfox.js overrides.js | awk -F: '{s+=$$2} END{print s}')" \
	  || { echo "a user_pref line does not end in );"; exit 1; }

install: $(DEB)
	@pgrep -x firefox-esr >/dev/null && { echo "Close Firefox first."; exit 1; } || true
	sudo dpkg -i $(DEB)
	$(MAKE) reload

reload:
	@pgrep -x firefox-esr >/dev/null && { echo "Close Firefox first."; exit 1; } || true
	rm -rf $(HOME)/.cache/mozilla/firefox/*/startupCache

update-fxac:
	rm -rf $(BUILD)/fxac
	git clone -q --depth 1 https://github.com/MrOtherGuy/fx-autoconfig $(BUILD)/fxac
	rm -rf $(FXAC)/utils
	cp -r $(BUILD)/fxac/profile/chrome/utils $(FXAC)/utils
	cp $(BUILD)/fxac/program/defaults/pref/config-prefs.js $(FXAC)/config-prefs.js
	cp $(BUILD)/fxac/LICENSE $(FXAC)/LICENSE
	git -C $(BUILD)/fxac rev-parse HEAD > $(FXAC)/COMMIT

clean:
	rm -rf $(BUILD)
